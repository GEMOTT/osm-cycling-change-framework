
@article{Curtis2013,
	title = {Using google street view for systematic observation of the built environment: analysis of spatio-temporal instability of imagery dates},
	volume = {12},
	issn = {1476-072X},
	shorttitle = {Using google street view for systematic observation of the built environment},
	url = {https://doi.org/10.1186/1476-072X-12-53},
	doi = {10.1186/1476-072X-12-53},
	abstract = {Recently, Google Street View (GSV) has been examined as a tool for remotely conducting systematic observation of the built environment. Studies have found it offers benefits over in-person audits, including efficiency, safety, cost, and the potential to expand built environment research to larger areas and more places globally. However, one limitation has been the lack of documentation on the date of imagery collection. In 2011, Google began placing a date stamp on images which now enables investigation of this concern. This study questions the spatio-temporal stability in the GSV date stamp. Specifically, is the imagery collected contemporaneously? If not, how frequently and where is imagery from different time periods woven together to represent environmental conditions in a particular place. Furthermore, how much continuity exists in imagery for a particular time period? Answering these questions will provide guidance on the use of GSV as a tool for built environment audits.},
	language = {en},
	number = {1},
	urldate = {2026-05-08},
	journal = {International Journal of Health Geographics},
	author = {Curtis, Jacqueline W. and Curtis, Andrew and Mapes, Jennifer and Szell, Andrea B. and Cinderich, Adam},
	month = dec,
	year = {2013},
	keywords = {Built environment audit, Date, Google Street View (GSV), Imagery, Spatial video},
	pages = {53},
	file = {Full Text PDF:/home/eugenividaltortosa/snap/zotero-snap/common/Zotero/storage/M6A4XH5H/Curtis et al. - 2013 - Using google street view for systematic observation of the built environment analysis of spatio-tem.pdf:application/pdf},
}
